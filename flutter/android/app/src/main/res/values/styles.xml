<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Deliberately light in both day/night resources: matches the Flutter app. -->
    <style name="QuethinkWindowTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:colorBackground">#F8F7FC</item>
        <item name="android:windowBackground">#F8F7FC</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="LaunchTheme" parent="QuethinkWindowTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#F8F7FC</item>
    </style>
    <style name="NormalTheme" parent="QuethinkWindowTheme" />
</resources>
