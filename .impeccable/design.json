  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action with hover, keyboard focus, and disabled treatment.",
      "html": "<button type=\"button\" class=\"ds-btn-primary\">Mulai belajar</button>",
      "css": ".ds-btn-primary{display:inline-flex;min-height:44px;height:44px;align-items:center;justify-content:center;gap:8px;border-radius:var(--radius-md,12px);padding:0 20px;font-size:14px;font-weight:600;transition:color 150ms cubic-bezier(.4,0,.2,1),background-color 150ms cubic-bezier(.4,0,.2,1),border-color 150ms cubic-bezier(.4,0,.2,1);font-family:var(--font-dm-sans,\"DM Sans\"),ui-sans-serif,system-ui,sans-serif;border:0;background:var(--primary,#4f46e5);color:var(--primary-foreground,#ffffff);}.ds-btn-primary:hover:not(:disabled){background:color-mix(in oklab,var(--primary,#4f46e5) 90%,transparent);}.ds-btn-primary:focus-visible{outline:2px solid var(--ring,#4f46e5);outline-offset:2px;}.ds-btn-primary:disabled{pointer-events:none;opacity:.5;cursor:not-allowed;}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Shared outline action with hover, keyboard focus, and disabled treatment.",
      "html": "<button type=\"button\" class=\"ds-btn-outline\">Lihat materi</button>",
      "css": ".ds-btn-outline{display:inline-flex;min-height:44px;height:44px;align-items:center;justify-content:center;gap:8px;border-radius:var(--radius-md,12px);padding:0 20px;font-size:14px;font-weight:600;transition:color 150ms cubic-bezier(.4,0,.2,1),background-color 150ms cubic-bezier(.4,0,.2,1),border-color 150ms cubic-bezier(.4,0,.2,1);font-family:var(--font-dm-sans,\"DM Sans\"),ui-sans-serif,system-ui,sans-serif;border:1px solid var(--border,#dedce9);background:var(--background,#f8f7fc);color:var(--foreground,#25223d);}.ds-btn-outline:hover:not(:disabled){background:var(--muted,#f1f0f7);}.ds-btn-outline:focus-visible{outline:2px solid var(--ring,#4f46e5);outline-offset:2px;}.ds-btn-outline:disabled{pointer-events:none;opacity:.5;cursor:not-allowed;}"
    },
    {
      "name": "Labeled Input",
      "kind": "input",
      "refersTo": "input",
      "description": "A readable mobile field with visible label, muted placeholder, and indigo focus.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-name\">Nama tampilan</label><input class=\"ds-input\" id=\"ds-name\" placeholder=\"Namamu\" type=\"text\" /></div>",
      "css": ".ds-field{max-width:320px;font-family:var(--font-dm-sans,\"DM Sans\"),ui-sans-serif,system-ui,sans-serif;}.ds-field-label{display:block;margin-bottom:8px;color:var(--foreground,#25223d);font-size:14px;font-weight:500;}.ds-input{width:100%;height:44px;border:1px solid var(--input,#b0acbf);border-radius:var(--radius-md,12px);background:var(--background,#f8f7fc);padding:8px 12px;color:var(--foreground,#25223d);caret-color:var(--primary,#4f46e5);font-size:16px;outline:none;font-family:var(--font-dm-sans,\"DM Sans\"),ui-sans-serif,system-ui,sans-serif;}.ds-input::placeholder{color:var(--muted-foreground,#625e78);}.ds-input:focus-visible{border-color:var(--ring,#4f46e5);box-shadow:0 0 0 2px color-mix(in oklab,var(--ring,#4f46e5) 20%,transparent);}.ds-input:disabled{opacity:.5;cursor:not-allowed;}@media(min-width:640px){.ds-input{font-size:14px;}}"
    },
    {
      "name": "Mobile Navigation",
      "kind": "nav",
      "refersTo": "mobile-nav-active",
      "description": "Five equal destinations with central Lab, icon labels, and a written current-page relationship.",
      "html": "<nav class=\"ds-mobile-nav\" aria-label=\"Navigasi utama\"><a class=\"ds-mobile-item\" href=\"/dashboard\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z\"/></svg><span>Beranda</span></a><a class=\"ds-mobile-item\" href=\"/learn/basis-data\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14M3 3h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5v17h-5a4 4 0 0 0-4 1 4 4 0 0 0-4-1H3Z\"/></svg><span>Materi</span></a><a class=\"ds-mobile-item\" href=\"/lab\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"/><path d=\"M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0\"/></svg><span>Lab</span></a><a class=\"ds-mobile-item\" href=\"/pre-test\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"18\" rx=\"2\"/><path d=\"M9 4V2h6v2M9 13l2 2 4-4\"/></svg><span>Tes</span></a><a class=\"ds-mobile-item\" href=\"/profile\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"7\" r=\"4\"/><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\"/></svg><span>Profil</span></a></nav>",
      "css": ".ds-mobile-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;max-width:576px;padding:4px 8px env(safe-area-inset-bottom);border-top:1px solid var(--border,#dedce9);background:var(--card,#ffffff);font-family:var(--font-dm-sans,\"DM Sans\"),ui-sans-serif,system-ui,sans-serif;}.ds-mobile-item{display:flex;min-height:56px;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:0 4px;border-radius:var(--radius-md,12px);color:var(--muted-foreground,#625e78);text-decoration:none;transition:color 150ms cubic-bezier(.4,0,.2,1),background-color 150ms cubic-bezier(.4,0,.2,1);}.ds-mobile-item span{white-space:nowrap;font-size:12px;font-weight:500;line-height:1;}.ds-mobile-item:hover,.ds-mobile-item[aria-current=\"page\"]{background:var(--secondary,#eeecfb);}.ds-mobile-item[aria-current=\"page\"]{color:var(--primary,#4f46e5);}.ds-mobile-item:focus-visible{outline:2px solid var(--ring,#4f46e5);outline-offset:2px;}"
    },
    {
      "name": "Lesson State Labels",
      "kind": "chip",
      "refersTo": "lesson-state",
      "description": "Informational labels use text plus distinct completed, in-progress, available, and locked marks.",
      "html": "<div class=\"ds-state-list\"><span class=\"ds-state\" data-state=\"completed\"><i aria-hidden=\"true\"></i>Tuntas</span><span class=\"ds-state\" data-state=\"progress\"><i aria-hidden=\"true\"></i>Sedang dipelajari</span><span class=\"ds-state\" data-state=\"available\"><i aria-hidden=\"true\"></i>Tersedia</span><span class=\"ds-state\" data-state=\"locked\"><i aria-hidden=\"true\"></i>Terkunci</span></div>",
      "css": ".ds-state-list{display:flex;flex-wrap:wrap;gap:16px;font-family:var(--font-dm-sans,\"DM Sans\"),ui-sans-serif,system-ui,sans-serif;}.ds-state{display:inline-flex;align-items:center;gap:8px;color:var(--foreground,#25223d);font-size:12px;font-weight:600;}.ds-state i{width:20px;height:2px;border-radius:9999px;background:var(--foreground,#25223d);}.ds-state[data-state=\"progress\"]{color:var(--primary,#4f46e5);}.ds-state[data-state=\"progress\"] i{width:12px;background:var(--live,#c56a25);}.ds-state[data-state=\"available\"] i{background:color-mix(in oklab,var(--muted-foreground,#625e78) 50%,transparent);}.ds-state[data-state=\"locked\"]{color:var(--muted-foreground,#625e78);}.ds-state[data-state=\"locked\"] i{opacity:.7;background:repeating-linear-gradient(to right,currentColor 0 3px,transparent 3px 6px);}"
    },
    {
      "name": "Learning Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat white grouped content with a quiet boundary and a keyboard reachable supporting link.",
      "html": "<section class=\"ds-panel\" aria-labelledby=\"ds-panel-title\"><h2 id=\"ds-panel-title\">Lanjutkan belajarmu</h2><p>Satu materi, satu percobaan, satu pemahaman baru.</p><a class=\"ds-panel-link\" href=\"/lab\">Lanjut ke Lab →</a></section>",
      "css": ".ds-panel{max-width:520px;border:1px solid color-mix(in oklab,var(--primary,#4f46e5) 15%,transparent);border-radius:var(--radius-lg,16px);background:var(--card,#ffffff);padding:24px;color:var(--foreground,#25223d);font-family:var(--font-dm-sans,\"DM Sans\"),ui-sans-serif,system-ui,sans-serif;}.ds-panel h2{margin:12px 0 0;font-size:24px;font-weight:600;line-height:32px;}.ds-panel p{max-width:55ch;margin:12px 0 0;color:var(--muted-foreground,#625e78);font-size:16px;line-height:28px;}.ds-panel-link{display:inline-flex;min-height:44px;align-items:center;margin-top:16px;color:var(--primary,#4f46e5);font-size:14px;font-weight:500;text-decoration:none;}.ds-panel-link:hover{text-decoration:underline;text-underline-offset:.2em;}.ds-panel-link:focus-visible{outline:2px solid var(--ring,#4f46e5);outline-offset:2px;}@media(min-width:640px){.ds-panel{padding:32px;}}"
    }
